# 이 파일을 복사해서 이름을 .env 로 바꾸고, = 뒤에 값을 붙여 넣으세요.
# .env 는 git에 올라가지 않습니다 (.gitignore). 따옴표는 없어도 됩니다.

# 인스타 게시 (필수)
INSTAGRAM_ACCESS_TOKEN_HOWABOUTHIS=

# 레퍼런스 계정 스캔 (Facebook 로그인 토큰 EAA…, 비즈니스 ID 178…)
IG_FB_ACCESS_TOKEN=
IG_FB_BUSINESS_ID=

# 네이버 검색량 (API HUB에서 발급한 키면 NAVER_API_HUB=1)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_HUB=1

# 나중에 쓸 것 (있을 때만)
GEMINI_API_KEY=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
